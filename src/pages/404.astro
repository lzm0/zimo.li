---
import Page from "../layouts/Page.astro";
import { localeUrl } from "../i18n";
---

<Page locale="en" title="Not found">
  <h1
    class="mb-6 text-xl font-semibold tracking-tighter text-balance sm:text-3xl"
  >
    Nothing here.
  </h1>
  <p class="text-muted text-lg">
    The page you are looking for does not exist.
    <a class="text-ink decoration-rule hover:text-accent underline underline-offset-4" href={localeUrl("en", "/")}>
      Back home
    </a>.
  </p>
</Page>
